# Database (SQLite default; use the asyncpg form for Postgres/Neon)
# DATABASE_URL=sqlite+aiosqlite:///./leadgen.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db?ssl=require

# Redis (optional — used by celery scaffolding only)
REDIS_URL=redis://localhost:6379/0

# LLM (OpenAI)
LLM_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-4o

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-key

# Brave Search API
BRAVE_SEARCH_API_KEY=your-brave-search-key

# Hunter.io API
HUNTER_API_KEY=your-hunter-key

# Sentry (optional)
SENTRY_DSN=

# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Auth (JWT)
AUTH_SECRET_KEY=leadgen-dev-secret-change-me
AUTH_TOKEN_EXPIRE_HOURS=24

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pipeline
max_leads=15
minimum_lead_score=45
